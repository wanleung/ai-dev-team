# Copy to .env and edit values
# cp .env.example .env

# PostgreSQL credentials (used by bundled postgres container)
POSTGRES_USER=rag
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=rag

# Embedding backend: ollama | vllm
EMBED_BACKEND=ollama

# Ollama (if EMBED_BACKEND=ollama)
# Use host.docker.internal to reach Ollama running on the host machine,
# or set the LAN IP if Ollama is on a separate machine.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=nomic-embed-text

# vLLM (if EMBED_BACKEND=vllm) — uncomment and set
# VLLM_BASE_URL=http://192.168.1.x:8000
# VLLM_MODEL=BAAI/bge-m3

# Search defaults
RAG_TOP_K=5
RAG_MAX_TOP_K=100
